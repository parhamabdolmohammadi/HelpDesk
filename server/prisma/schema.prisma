// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  AGENT
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TicketCategory {
  GENERAL_QUESTION
  TECHNICAL_QUESTION
  REFUND_REQUEST
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  role      UserRole  @default(AGENT)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  assignedTickets Ticket[]
  ticketReplies   TicketReply[]
  emailVerified   Boolean       @default(false)
  image           String?
  updatedAt       DateTime      @updatedAt
  sessions        Session[]
  accounts        Account[]

  @@map("user")
}

model Ticket {
  id             String          @id @default(cuid())
  subject        String
  requesterEmail String
  status         TicketStatus    @default(OPEN)
  category       TicketCategory?
  assignee       User?           @relation(fields: [assigneeId], references: [id])
  assigneeId     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  // Set by the auto-resolve job (see jobs/autoResolveTicket.ts) when it
  // answers a ticket from the knowledge base and resolves it without a
  // human agent. Drives the dashboard's "resolved by AI" stats.
  autoResolved   Boolean         @default(false)
  // Set whenever status transitions to RESOLVED (by a human via PATCH /:id,
  // or by the auto-resolve job) and cleared if it's moved away from
  // RESOLVED again — a dedicated timestamp rather than reusing updatedAt,
  // since updatedAt also changes for unrelated edits (assignee, category,
  // a new reply) made after resolution. The dashboard's average resolution
  // time is computed from this minus createdAt.
  resolvedAt     DateTime?

  messages       TicketMessage[]
  replies        TicketReply[]
}

model TicketMessage {
  id         Int      @id @default(autoincrement())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  fromEmail  String
  senderName String
  body       String
  createdAt  DateTime @default(now())
}

// An agent/admin's reply on a ticket, distinct from TicketMessage (which is
// only inbound requester emails) — a reply has an authenticated author
// instead of a from-address, and, once outbound email sending exists, is
// the model that would actually get emailed back to the requester.
//
// authorId/senderType are nullable because an auto-resolve reply (see
// isAiGenerated below) has no authenticated User behind it — there's no
// author to snapshot a role from.
model TicketReply {
  id             String    @id @default(cuid())
  ticketId       String
  ticket         Ticket    @relation(fields: [ticketId], references: [id])
  authorId       String?
  author         User?     @relation(fields: [authorId], references: [id])
  // Snapshot of the author's role at the time they replied (not a live
  // join against User.role), so a reply's badge in the UI stays accurate
  // even if that user's role changes later.
  senderType     UserRole?
  // True for a reply generated by the auto-resolve job rather than typed by
  // an agent/admin — the UI uses this to show an "AI" badge instead of the
  // ADMIN/AGENT badge derived from senderType.
  isAiGenerated  Boolean   @default(false)
  body           String
  createdAt      DateTime  @default(now())
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
